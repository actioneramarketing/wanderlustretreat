# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# Example: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend API key — required for inquiry form delivery in production
RESEND_API_KEY=

# Destination inbox for retreat inquiries
RETREAT_INQUIRY_TO_EMAIL=

# Verified sender address in Resend (e.g. inquiries@your-domain.com)
RETREAT_INQUIRY_FROM_EMAIL=
